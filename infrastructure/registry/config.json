{
  "distSpecVersion": "1.1.1",
  "storage": {
    "rootDirectory": "/var/lib/registry",
    "commit": true,
    "dedupe": true,
    "gc": true,
    "gcDelay": "1h",
    "gcInterval": "24h"
  },
  "http": {
    "address": "0.0.0.0",
    "port": "5000",
    "realm": "zot",
    "readTimeout": "15m",
    "writeTimeout": "15m",
    "compat": ["docker2s2"],
    "tls": {
      "cert": "/tls/tls.crt",
      "key": "/tls/tls.key"
    },
    "auth": {
      "failDelay": 5,
      "htpasswd": {
        "path": "/secret/htpasswd"
      }
    },
    "accessControl": {
      "repositories": {
        "loky/**": {
          "policies": [
            {
              "users": ["loky-cluster-pull"],
              "actions": ["read"]
            },
            {
              "users": ["loky-ci-push"],
              "actions": ["read", "create", "update"]
            }
          ],
          "defaultPolicy": []
        }
      },
      "adminPolicy": {
        "users": ["registry-admin"],
        "actions": ["read", "create", "update", "delete"]
      }
    }
  },
  "log": {
    "level": "info"
  },
  "extensions": {
    "search": {
      "enable": true
    },
    "ui": {
      "enable": true
    }
  }
}
